# --- Saturn build output -----------------------------------------------------
saturn/BuildDrop/
**/*.o
**/*.elf
**/*.iso
**/*.cue
**/*.bin.tmp
    # 0.bin is the linked program objcopy'd into the disc image on every build.
# It is committed as part of the CD skeleton, so ignore only the build dir above.

# --- Cross-compiler and iso2raw (fetched into the SDK submodule, never committed)
SaturnRingLib/Compiler/
SaturnRingLib/tools/bin/

# --- Host/IDE build dirs -----------------------------------------------------
cmake-build-*/

# --- Visual brainstorming session scratch ------------------------------------
# Mockups the design companion serves to the browser. Working material, not source.
.superpowers/

# --- Host unit-test binaries --------------------------------------------------
# saturn/tests/run_tests.sh builds these with the host g++ (not the SH-2 cross
# compiler), one binary per suite, so each area can be tested off-target. Build
# output, not source. Both spellings: MSYS g++ emits .exe on Windows.
saturn/tests/run_tests_scsp
saturn/tests/run_tests_scsp.exe
saturn/tests/run_tests_savefmt
saturn/tests/run_tests_savefmt.exe
saturn/tests/run_tests_bupdate
saturn/tests/run_tests_bupdate.exe
saturn/tests/run_tests_bupstub
saturn/tests/run_tests_bupstub.exe
saturn/tests/run_tests_savedata
saturn/tests/run_tests_savedata.exe
saturn/tests/run_tests_menustate
saturn/tests/run_tests_menustate.exe
saturn/tests/run_tests_menudraw
saturn/tests/run_tests_menudraw.exe

# --- Non-free game data ------------------------------------------------------
# Another World's original PC DOS data files. Required to run, never committed.
# Both cases listed: the engine asks for them lowercase (bank.cxx builds the name
# with sprintf("bank%02x")) and ISO9660 stores them uppercase, so either spelling
# can show up on disk depending on where they were copied from. Git's ignore
# matching is case-sensitive wherever core.ignorecase is false, e.g. CI on Linux.
saturn/cd/data/BANK*
saturn/cd/data/bank*
saturn/cd/data/MEMLIST.BIN
saturn/cd/data/memlist.bin

# SGL sound driver files the makefile copies in from the SGL module directory
# whenever SRL_USE_SGL_SOUND_DRIVER = 1. Build output, not source.
saturn/cd/data/0.bin
saturn/cd/data/BOOTSND.MAP
saturn/cd/data/SDDRVS.DAT
saturn/cd/data/SDDRVS.TSK
